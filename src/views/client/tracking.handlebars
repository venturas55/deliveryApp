<section class="card"><h1>Pedido #{{order.id}}</h1><h2>{{order.statusLabel}}</h2>
  <p>{{date order.created_at}}</p><p><strong>{{#if (eq order.delivery_method "pickup")}}Recogida en local{{else}}Entrega a domicilio{{/if}}</strong></p><p>{{order.delivery_address}}</p>
  <ul>{{#each order.items}}<li>{{quantity}} × {{product_name}} — {{money (multiply quantity unit_price_cents)}}</li>{{/each}}</ul>
  <p>Subtotal: {{money order.subtotal_cents}}<br>Envío: {{money order.delivery_cents}}</p><strong>Total: {{money order.total_cents}}</strong>
  {{#if order.dropoffEta}}<p>Entrega estimada: {{date order.dropoffEta}}</p>{{/if}}
  {{#if order.trackingUrl}}<p><a href="{{order.trackingUrl}}" target="_blank" rel="noopener noreferrer">Seguir al repartidor</a></p>{{/if}}
  {{#if order.deliveryVerification}}<p>{{#if (eq order.deliveryVerification.outcome "SUCCESS")}}Entrega verificada{{else}}Verificación de entrega pendiente{{/if}}</p>{{/if}}
  {{#if order.hasDeliveryVerificationQr}}<div class="pickup-label"><h3>Verificación de entrega</h3><img src="/api/customer/orders/{{order.id}}/delivery/qr" width="320" height="320" alt="QR de verificación de entrega del pedido {{order.id}}"><p>Muestra este QR al repartidor cuando llegue para verificar la entrega.</p></div>{{/if}}
  <p><a href="/tracking?id={{order.id}}">Actualizar estado</a> · <a href="/client/orders">Mis pedidos</a></p>
</section>
