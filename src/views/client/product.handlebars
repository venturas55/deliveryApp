<section class="product-detail">

  <article class="product-detail-card">

    <div class="product-detail-image">
      {{#if product.image_url}}
        <img
          src="{{product.image_url}}"
          alt="{{#if product.image_description}}{{product.image_description}}{{else}}{{product.name}}{{/if}}"
          loading="lazy"
        >
      {{else}}
        <img
          src="/img/default.png"
          alt="{{product.name}}"
          loading="lazy"
          class="product-detail-placeholder"
        >
      {{/if}}
    </div>

    <div class="product-detail-content">

      <span class="product-detail-eyebrow">Nuestra carta</span>

      <div class="product-detail-heading">
        <h1>{{product.name}}</h1>

        <span class="product-detail-price">
          {{money product.price_cents}}
        </span>
      </div>

      {{#if product.description}}
        <p class="product-detail-description">
          {{product.description}}
        </p>
      {{/if}}

      <div class="product-detail-divider"></div>

      <p class="product-detail-note">
        Preparado al momento para tu pedido.
      </p>

    </div>

  </article>


  <nav class="product-detail-navigation" aria-label="Navegación de la carta">
   <a href="javascript:history.back()" class="product-back">
      <span aria-hidden="true">←</span>
      Volver a la carta
    </a>
  </nav>

</section>