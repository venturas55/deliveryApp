<section class="card"><h1>Mi cuenta</h1><p>Datos y dirección habitual para tus pedidos.</p>
  {{#if saved}}<p class="success" role="status">Datos guardados.</p>{{/if}}
  <form id="accountForm" method="post" action="/client/account">{{> csrf}}
    <label>Email de acceso<input type="email" value="{{profile.email}}" readonly></label>
    <label>Nombre<input name="name" value="{{profile.name}}" maxlength="120" autocomplete="name" required></label>
    <label>Teléfono<input name="phone" value="{{profile.phone}}" type="tel" maxlength="40" autocomplete="tel"></label>
    <label>Dirección completa<textarea name="delivery_address" maxlength="500" autocomplete="street-address">{{profile.delivery_address}}</textarea></label>
    <label>Indicaciones<textarea name="delivery_notes" maxlength="500">{{profile.delivery_notes}}</textarea></label><button>Guardar datos</button>
  </form>
</section>
