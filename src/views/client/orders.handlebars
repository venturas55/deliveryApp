<section><h1>Mis pedidos</h1>
  <form method="get" action="/client/orders" class="filter-form"><label>Mostrar<select name="filter"><option value="active"{{#if (eq filter "active")}} selected{{/if}}>En curso</option><option value="history"{{#if (eq filter "history")}} selected{{/if}}>Historial</option><option value="all"{{#if (eq filter "all")}} selected{{/if}}>Todos</option></select></label><button>Filtrar</button></form>
  <div id="customerOrders">{{#each orders}}<article class="order-card"><h2>Pedido #{{id}} · {{statusLabel}}</h2><p>{{date created_at}} · {{money total_cents}}</p><a href="/tracking?id={{id}}">Ver detalle y seguimiento</a></article>{{else}}<p>No tienes pedidos en esta sección.</p>{{/each}}</div>
</section>
