<section class="card"><h1>Iniciar sesión</h1>
  <form id="customerLogin" method="post" action="/client/login">{{> csrf}}<input type="hidden" name="next" value="{{next}}">
    <label>Email<input name="email" type="email" maxlength="190" autocomplete="email" required></label>
    <label for="customer-password">Contraseña</label>
    <div class="password-field"><input id="customer-password" name="password" type="password" autocomplete="current-password" required><button class="password-toggle" type="button" aria-controls="customer-password" aria-pressed="false" aria-label="Mostrar contraseña" title="Mostrar contraseña">{{> password-eye}}</button></div><button>Entrar</button>
  </form>
  <p><a href="/client/forgot-password">¿Olvidaste tu contraseña?</a></p>
  {{#if passwordReset}}<p role="status">Contraseña actualizada. Ya puedes iniciar sesión.</p>{{/if}}
  {{#if passwordSet}}<p role="status">Contraseña establecida. Ya puedes iniciar sesión.</p>{{/if}}
  {{#if googleEnabled}}<p data-google-consent-note role="status">Para iniciar sesión con Google, primero acepta los servicios opcionales desde el aviso de cookies.</p><div id="googleButton" data-next="{{next}}"></div><p id="googleMessage" role="alert"></p>{{/if}}
</section>
<section class="card"><h2>Crear cuenta</h2>
  <form id="customerRegister" method="post" action="/client/register">{{> csrf}}<input type="hidden" name="next" value="{{next}}">
    <label>Nombre<input name="name" maxlength="120" autocomplete="name" required></label>
    <label>Email<input name="email" type="email" maxlength="190" autocomplete="email" required></label>
    <label for="register-password">Contraseña</label>
    <div class="password-field"><input id="register-password" name="password" type="password" minlength="8" autocomplete="new-password" required><button class="password-toggle" type="button" aria-controls="register-password" aria-pressed="false" aria-label="Mostrar contraseña" title="Mostrar contraseña">{{> password-eye}}</button></div><p>Al menos 8 caracteres.</p><button>Registrarme</button>
  </form>
</section>
<script src="/password-toggle.js" defer></script>
