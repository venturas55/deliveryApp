<div class="address-picker" data-address-picker data-search-url="/admin/address-search">
  <label>Buscar dirección
    <input
  class="address-search"
  type="text"
  value="{{#unless addressData.formatted_address}}{{configs.address}}{{/unless}}"
  autocomplete="off"
  autocorrect="off"
  autocapitalize="none"
  spellcheck="false"
  inputmode="search"
  placeholder="Calle Alcalá 123 Madrid"
  data-address-search
>
  </label>
  <div class="address-suggestions" data-address-suggestions role="listbox" aria-label="Sugerencias de dirección" hidden></div>
  <input type="hidden" name="delivery_address_data" value="{{#if addressData.formatted_address}}{{json addressData}}{{/if}}" data-address-data>
  <section class="address-confirmation" data-address-confirmation{{#unless addressData.formatted_address}} hidden{{/unless}}>
    <p class="address-confirmation-title">Direccion seleccionada</p>
    <strong data-address-street>{{addressData.street}}{{#if addressData.number}} {{addressData.number}}{{/if}}</strong>
    <span data-address-formatted>{{addressData.formatted_address}}</span>
    <small data-address-location>{{addressData.city}}{{#if addressData.postal_code}} · {{addressData.postal_code}}{{/if}}{{#if addressData.country}} · {{addressData.country}}{{/if}}</small>
    
  </section>
</div>