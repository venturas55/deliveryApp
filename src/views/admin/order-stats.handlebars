<section class="orders-page section-page order-stats-page admin-page">
  <header class="orders-header admin-page-header">
    <div>
      <span class="orders-eyebrow">RESUMEN DEL RESTAURANTE</span>
      <h1>Estadísticas de pedidos</h1>
      <p>Pedidos recibidos por día y por franja horaria.</p>
    </div>
    <a class="orders-filter-button" href="/admin/orders">Volver a pedidos</a>
  </header>

  <section class="stats-panel" aria-labelledby="daily-title">
    <div class="stats-panel-heading"><div><h2 id="daily-title">Pedidos por día</h2><p>Últimos 14 días</p></div></div>
    <div class="stats-bars stats-bars--daily">
      {{#each stats.daily}}
        <button class="stats-bar-item stats-day-button" type="button" data-day="{{day}}" aria-label="Ver pedidos por hora del {{label}}: {{total}} pedidos">
          <span class="stats-bar-value">{{total}}</span>
          <div class="stats-bar-track"><span class="stats-bar-fill" style="height:{{width}}%"></span></div>
          <span class="stats-bar-label">{{label}}</span>
        </button>
        <template id="hours-{{day}}">
          <div class="stats-hours stats-hours--dialog">
            {{#each hourly}}
              <div class="stats-hour-item"><span class="stats-hour-label">{{label}}</span><span class="stats-hour-track"><span class="stats-hour-fill" style="width:{{width}}%"></span></span><strong>{{total}}</strong></div>
            {{/each}}
          </div>
        </template>
      {{/each}}
    </div>
  </section>

  <section class="stats-panel" aria-labelledby="hours-title">
    <div class="stats-panel-heading"><div><h2 id="hours-title">Pedidos por franja horaria</h2><p>Totales acumulados</p></div></div>
    <div class="stats-hours">
      {{#each stats.hourly}}
        <div class="stats-hour-item"><span class="stats-hour-label">{{label}}</span><span class="stats-hour-track"><span class="stats-hour-fill" style="width:{{width}}%"></span></span><strong>{{total}}</strong></div>
      {{/each}}
    </div>
  </section>
  <section class="stats-panel" aria-labelledby="customer-spending-title">
    <div class="stats-panel-heading"><div><h2 id="customer-spending-title">Clientes que más han gastado</h2><p>Histórico del restaurante · Pedidos entregados, sin reembolsados. Incluye envío y descuentos.</p></div></div>
    {{#if stats.customerSpending.length}}
      <div class="stats-table-scroll" role="region" aria-labelledby="customer-spending-title" tabindex="0">
        <table class="stats-customers-table">
          <thead><tr><th scope="col">Posición</th><th scope="col">Cliente</th><th scope="col">Contacto</th><th scope="col">Pedidos</th><th scope="col">Total gastado</th></tr></thead>
          <tbody>
            {{#each stats.customerSpending}}
              <tr><td>{{rank}}</td><th scope="row">{{name}}</th><td>{{email}}{{#if phone}}<br>{{phone}}{{/if}}</td><td>{{total_orders}}</td><td><strong>{{money total_spent_cents}}</strong></td></tr>
            {{/each}}
          </tbody>
        </table>
      </div>
    {{else}}
      <p>Todavía no hay clientes con pedidos entregados.</p>
    {{/if}}
  </section>
  <dialog class="stats-day-dialog" aria-labelledby="stats-day-dialog-title">
    <div class="stats-day-dialog-header"><h2 id="stats-day-dialog-title">Pedidos por hora</h2><button type="button" class="stats-day-dialog-close" aria-label="Cerrar">×</button></div>
    <div class="stats-day-dialog-content"></div>
  </dialog>
</section>
<script src="/admin-order-stats.js" defer></script>
