<section id="adminMain" class="orders-page section-page admin-page orders-native">
  <header class="admin-page-header">
    <div><h1>Pedidos</h1><p>{{orders.length}} pedidos · {{#if refresh}}Actualización automática{{else}}Historial{{/if}}</p></div>
    <a class="orders-chip" href="{{refreshUrl}}">Actualizar</a>
  </header>
  <nav class="orders-status-chips" aria-label="Estado del pedido">
    {{#each statusFilters}}<a class="orders-chip {{#if selected}}is-selected{{/if}}" href="{{href}}" {{#if selected}}aria-current="page"{{/if}}>{{label}}</a>{{/each}}
  </nav>
  <div class="orders-native-toolbar">
    <nav class="orders-delivery-chips" aria-label="Tipo de entrega">
      {{#each deliveryFilters}}<a class="orders-chip {{#if selected}}is-selected{{/if}}" href="{{href}}" {{#if selected}}aria-current="page"{{/if}}>{{label}}</a>{{/each}}
    </nav>
    <form method="get" action="/admin/orders" data-orders-filter class="orders-native-payment">
      <input type="hidden" name="filter" value="{{filter}}">
      {{#unless (eq status "all")}}<input type="hidden" name="status" value="{{status}}">{{/unless}}
      <input type="hidden" name="delivery_method" value="{{deliveryFilter}}">
      <label for="orders-payment-filter">Pago</label>
      <select id="orders-payment-filter" name="payment_method">
        <option value="all" {{#if (eq paymentFilter "all")}}selected{{/if}}>Todos los pagos</option>
        <option value="card" {{#if (eq paymentFilter "card")}}selected{{/if}}>Tarjeta</option>
        <option value="cash" {{#if (eq paymentFilter "cash")}}selected{{/if}}>Efectivo</option>
      </select>
      <noscript><button type="submit">Filtrar</button></noscript>
    </form>
  </div>
  <div id="orders" class="orders-grid">
    {{#each orders}}
    <a class="order-card orders-native-card" href="/admin/orders/{{id}}" aria-label="Gestionar pedido #{{id}} de {{customer_name}}">
      <div class="orders-native-card-top"><h2>#{{id}}</h2><strong>{{money total_cents}}</strong></div>
      <div class="orders-native-customer">
        <span class="order-customer-avatar" aria-hidden="true">{{#if customer_profile_image_url}}<img src="{{customer_profile_image_url}}" alt="" loading="lazy" referrerpolicy="no-referrer">{{else}}{{customer_initials}}{{/if}}</span>
        <span>{{customer_name}}</span>
      </div>
      <span class="order-status order-status--{{status}}">{{statusLabel}}</span>
      <p class="orders-native-meta">{{#if (eq delivery_method "pickup")}}Recogida{{else}}Reparto{{/if}} · {{#if (eq payment_method "online")}}Tarjeta online{{else if (eq payment_method "cash")}}Efectivo{{else}}Tarjeta al repartidor{{/if}} · <span class="orders-native-payment--{{payment_status}}">{{#if (eq payment_status "paid")}}Pagado{{else if (eq payment_status "refunded")}}Reembolsado{{else if (eq payment_status "refund_pending")}}Devolución en curso{{else if (eq payment_status "failed")}}Pago fallido{{else if (eq payment_status "cancelled")}}Pago cancelado{{else}}Pendiente de pago{{/if}}</span></p>
      <p class="orders-native-meta">{{date created_at}} · {{#if finished}}Finalizado{{else}}{{elapsedMinutes}} min transcurridos{{/if}}</p>
      <p class="orders-native-meta"><strong>Hora solicitada: {{scheduleLabel}}</strong></p>
      {{#if delivery_notes}}<p class="orders-native-note">{{delivery_notes}}</p>{{/if}}
    </a>
    {{else}}
    <div class="orders-empty"><h2>Sin pedidos en este estado</h2><p>Cambia los filtros para consultar otros pedidos.</p></div>
    {{/each}}
  </div>
  <nav class="orders-pagination" aria-label="Paginación de pedidos">
    {{#if previousUrl}}<a class="orders-chip" href="{{previousUrl}}">Pedidos anteriores</a>{{/if}}
    {{#if recentUrl}}<a class="orders-chip" href="{{recentUrl}}">Volver a los recientes</a>{{/if}}
  </nav>
</section>
