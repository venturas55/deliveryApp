<section class="card"><h1>Acceso del restaurante</h1>
  <form id="login" method="post" action="/admin/login">{{> csrf}}
    <label>Email<input name="email" type="email" autocomplete="username" required></label>
    <label for="admin-password">Contraseña</label>
    <div class="password-field"><input id="admin-password" name="password" type="password" autocomplete="current-password" required><button class="password-toggle" type="button" aria-controls="admin-password" aria-pressed="false" aria-label="Mostrar contraseña" title="Mostrar contraseña">{{> password-eye}}</button></div><button>Entrar</button>
  </form>
</section>
<script src="/password-toggle.js" defer></script>
