<div class="admin-page admin-page--products">
<section class="products-page">
  <div class="products-heading admin-page-header">
    <div>
      <span class="products-eyebrow">CATÁLOGO DEL RESTAURANTE</span>
      <h1>Productos</h1>
      <p>Organiza artículos, precios e imágenes de tu carta.</p>
    </div>
    <a class="products-primary-link" href="#productForm">＋ Nuevo producto</a>
  </div>

  <div class="products-summary" aria-label="Resumen de productos">
    <div><span>Total productos</span><strong>{{productCount}}</strong></div>
    <div><span>Disponibles</span><strong>{{activeProductCount}}</strong></div>
  </div>

  <div class="products-list-heading">
    <div><h2>Tu carta</h2><p>Gestiona los productos visibles para tus clientes.</p></div>
    <span>{{productCount}} artículos</span>
  </div>

  <div class="products-grid" id="products">
    {{#each products}}
      <article class="product-card">
        <div class="product-card-image">
          {{#if image_url}}
            <img src="{{image_url}}" alt="{{#if image_description}}{{image_description}}{{else}}{{name}}{{/if}}" loading="lazy">
          {{else}}
            <span aria-hidden="true">{{category}}</span>
          {{/if}}
          <span class="product-status{{#unless active}} product-status--hidden{{/unless}}">{{#if active}}Disponible{{else}}Oculto{{/if}}</span>
        </div>
        <div class="product-card-body">
          <div class="product-card-title"><h3>{{name}}</h3><strong>{{money price_cents}}</strong></div>
          <p class="product-card-category">{{category}} <span>·</span> Orden {{sort_order}}</p>
          {{#if description}}<p class="product-card-description">{{description}}</p>{{/if}}
          {{#if image_description}}<p class="product-card-caption">Foto: {{image_description}}</p>{{/if}}
          <div class="product-card-actions">
            <a class="product-button product-button--primary" href="/admin/products?edit={{id}}">Editar</a>
            <form method="post" action="/admin/products/{{id}}/toggle">{{> csrf}}
              <input type="hidden" name="active" value="{{#if active}}0{{else}}1{{/if}}">
              <button class="product-button product-button--secondary" type="submit">{{#if active}}Ocultar{{else}}Publicar{{/if}}</button>
            </form>
            <a class="product-delete-link" href="/admin/products/{{id}}/delete">Eliminar</a>
          </div>
        </div>
      </article>
    {{else}}
      <div class="products-empty"><span aria-hidden="true">＋</span><h3>Aún no hay productos</h3><p>Añade el primer artículo para empezar a completar tu carta.</p><a href="#productForm">Crear producto</a></div>
    {{/each}}
  </div>
</section>

<aside class="card product-editor" id="productForm">
  <div class="product-editor-heading">
    <span class="products-eyebrow">{{#if product.id}}EDITAR CATÁLOGO{{else}}NUEVO EN LA CARTA{{/if}}</span>
    <h2>{{#if product.id}}Editar producto{{else}}Añadir producto{{/if}}</h2>
    <p>Completa los datos para mostrar el artículo en tu carta.</p>
  </div>
  <form method="post" enctype="multipart/form-data" action="{{#if product.id}}/admin/products/{{product.id}}/edit{{else}}/admin/products{{/if}}">{{> csrf}}
    <label class="product-field">Nombre del producto<input name="name" value="{{product.name}}" maxlength="120" placeholder="Ej. Pizza Margarita" required></label>
    <label class="product-field">Descripción<textarea name="description" maxlength="255" rows="3" placeholder="Ingredientes o detalles del producto">{{product.description}}</textarea></label>
    <div class="product-fields-row">
      <label class="product-field">Categoría<input name="category" value="{{product.category}}" maxlength="80" placeholder="Pizzas" required></label>
      <label class="product-field">Precio (€)<input name="price" type="number" min="0" max="21474836.47" step="0.01" value="{{decimal product.price_cents}}" placeholder="0,00" required></label>
    </div>
    <label class="product-field">Orden en la carta<input name="sort_order" type="number" min="0" max="2147483647" step="1" value="{{product.sort_order}}" required><small>Los números menores aparecen primero.</small></label>

    <div class="product-image-section">
      <h3>Imagen del producto</h3>
      {{#if product.image_url}}<img class="product-current-image" src="{{product.image_url}}" alt="{{#if product.image_description}}{{product.image_description}}{{else}}{{product.name}}{{/if}}">{{/if}}
      <label class="product-field">Subir imagen<input class="product-file-input" name="image" type="file" accept="image/jpeg,image/png,image/webp"><small>JPEG, PNG o WebP. Máximo 5 MB. Si editas, deja vacío para conservar la imagen actual.</small></label>
      <label class="product-field">Descripción de la imagen<textarea name="image_description" maxlength="255" rows="2" placeholder="Describe la imagen para hacerla accesible">{{product.image_description}}</textarea></label>
    </div>

    <label class="product-availability"><input class="checkbox" name="active" value="1" type="checkbox"{{#if product.active}} checked{{/if}}><span><strong>Disponible en la carta</strong><small>Los clientes podrán ver y pedir este producto.</small></span></label>
    <div class="product-editor-actions">
      <button class="product-button product-button--primary" type="submit">{{#if product.id}}Guardar cambios{{else}}Añadir producto{{/if}}</button>
      {{#if product.id}}<a class="product-cancel-link" href="/admin/products">Cancelar edición</a>{{/if}}
    </div>
  </form>
</aside>

<section class="promotion-manager" id="promotions" aria-labelledby="promotions-heading">
  <header class="products-list-heading">
    <div><h2 id="promotions-heading">Promociones y códigos de descuento</h2><p>Los códigos se aplican en la cesta y se vuelven a calcular al confirmar el pedido.</p></div>
    <a class="products-primary-link" href="#promotionForm">＋ Nueva promoción</a>
  </header>

  <div class="promotion-list">
    {{#each promotionList}}
      <article class="promotion-card">
        <div><h3>{{name}}</h3><p><strong>{{code}}</strong> · {{#if (eq promotion_type "percentage")}}{{percentage}}% descuento{{else}}Compra {{trigger_quantity}}, regala {{reward_quantity}}{{/if}}</p>
          {{#if trigger_product_name}}<p>Compra: {{trigger_product_name}}</p>{{else if trigger_category}}<p>Compra categoría: {{trigger_category}}</p>{{/if}}
          {{#if reward_product_name}}<p>Gratis: {{reward_product_name}}</p>{{else if reward_category}}<p>Gratis categoría: {{reward_category}}</p>{{/if}}
          <span>{{#if active}}Activa{{else}}Pausada{{/if}}</span>
        </div>
        <div class="product-card-actions">
          <a class="product-button product-button--primary" href="/admin/products?promotion_edit={{id}}#promotions">Editar</a>
          <form method="post" action="/admin/promotions/{{id}}/toggle">{{> csrf}}<input type="hidden" name="active" value="{{#if active}}0{{else}}1{{/if}}"><button class="product-button product-button--secondary">{{#if active}}Pausar{{else}}Activar{{/if}}</button></form>
          <form method="post" action="/admin/promotions/{{id}}/delete" data-confirm="¿Eliminar el código {{code}}?">{{> csrf}}<button class="product-delete-link">Eliminar</button></form>
        </div>
      </article>
    {{else}}
      <p>Aún no hay promociones.</p>
    {{/each}}
  </div>

  <aside class="card promotion-editor" id="promotionForm">
    <h3>{{#if promotion.id}}Editar promoción{{else}}Crear promoción{{/if}}</h3>
    <form method="post" action="{{#if promotion.id}}/admin/promotions/{{promotion.id}}/edit{{else}}/admin/promotions{{/if}}">
      {{> csrf}}
      <label>Nombre<input name="name" maxlength="120" value="{{promotion.name}}" required></label>
      <label>Código<input name="code" maxlength="32" pattern="[A-Za-z0-9_-]{3,32}" value="{{promotion.code}}" aria-describedby="promotion-code-help" required><small id="promotion-code-help">3-32 letras, números, guion o guion bajo.</small></label>
      <label>Tipo<select name="promotion_type" required>
        <option value="percentage"{{#if (eq promotion.promotion_type "percentage")}} selected{{/if}}>Porcentaje de descuento</option>
        <option value="buy_get"{{#if (eq promotion.promotion_type "buy_get")}} selected{{/if}}>Compra productos y recibe unidades gratis</option>
      </select></label>
      <label>Porcentaje<input name="percentage" type="number" min="1" max="100" value="{{promotion.percentage}}"><small>Se descuenta del subtotal de artículos.</small></label>

      <fieldset><legend>Regla de compra y regalo</legend>
        <label>Compra categoría<select name="trigger_category"><option value="">Elige categoría</option>{{#each productCategories}}<option value="{{this}}"{{#if (eq this ../promotion.trigger_category)}} selected{{/if}}>{{this}}</option>{{/each}}</select></label>
        <label>O compra producto<select name="trigger_product_id"><option value="">Cualquier producto de la categoría</option>{{#each products}}<option value="{{id}}"{{#if (eq id ../promotion.trigger_product_id)}} selected{{/if}}>{{name}} ({{category}})</option>{{/each}}</select></label>
        <label>Unidades necesarias<input name="trigger_quantity" type="number" min="1" max="50" value="{{promotion.trigger_quantity}}"><small>Ejemplo: 2 para 2x1; 3 para regalar algo por cada 3 pizzas.</small></label>
        <label>Regalo categoría<select name="reward_category"><option value="">Elige categoría</option>{{#each productCategories}}<option value="{{this}}"{{#if (eq this ../promotion.reward_category)}} selected{{/if}}>{{this}}</option>{{/each}}</select></label>
        <label>O regalo producto<select name="reward_product_id"><option value="">Cualquier producto de la categoría</option>{{#each products}}<option value="{{id}}"{{#if (eq id ../promotion.reward_product_id)}} selected{{/if}}>{{name}} ({{category}})</option>{{/each}}</select></label>
        <label>Unidades gratis por regla<input name="reward_quantity" type="number" min="1" max="50" value="{{#if promotion.reward_quantity}}{{promotion.reward_quantity}}{{else}}1{{/if}}"></label>
      </fieldset>
      <button class="product-button product-button--primary" type="submit">{{#if promotion.id}}Guardar promoción{{else}}Crear promoción{{/if}}</button>
      {{#if promotion.id}}<a class="product-cancel-link" href="/admin/products#promotions">Cancelar edición</a>{{/if}}
    </form>
  </aside>
</section>
</div>
