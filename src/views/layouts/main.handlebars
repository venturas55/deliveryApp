<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{title}} · {{restaurantName}}</title>
  <link rel="stylesheet" href="/style.css">
  {{#if clientArea}}<link rel="stylesheet" href="/client.css">{{/if}}
</head>
<body class="{{#if clientArea}}client-area{{/if}}"{{#if refresh}} data-refresh="5000"{{/if}}>
  {{> header}}
  {{#if adminArea}}{{#if adminLoggedIn}}{{> admin/navigation}}{{/if}}{{/if}}
  <main>{{{body}}}</main>
  <script src="/page-behavior.js" defer></script>
  <script src="/address-picker.js?v=2" defer></script>
  {{#if googleEnabled}}<script src="/google-login.js" defer></script>{{/if}}
</body>
</html>
