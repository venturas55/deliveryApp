NODE_ENV=development
GOOGLE_CLIENT_ID=
PORT=7007
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=reparto
DB_USER=reparto
DB_PASSWORD=change_me

# Admin
ADMIN_EMAIL=asdsaf@hotmail.com
ADMIN_PASSWORD=change_me
JWT_SECRET=change_me_jwt
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DELIVERY_CREDENTIALS_KEY=
# Geocoding is server-side; use an application-specific User-Agent in production.
GEOCODER_BASE_URL=https://nominatim.openstreetmap.org
GEOCODER_USER_AGENT=delivery-app/1.0 (admin@example.com)

# Restaurant defaults
RESTAURANT_NAME=Pizzería Demo

# Provider credentials and settings are configured per restaurant in /admin/providers.
# Set DELIVERY_PROVIDER=mock only for local mock-delivery tests.
# set DELIVERY_SIMULATION=true for tests